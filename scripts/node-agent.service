[Unit]
Description=Node Control Agent Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/node-agent/workdir
ExecStart=/opt/node-agent/node-agent -port 9090 -share-port 9091 -secret "YOUR_SECRET_TOKEN" -dir /opt/node-agent/workdir
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
